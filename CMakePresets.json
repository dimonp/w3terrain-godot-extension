{
    "version": 3,
    "configurePresets": [
        {
            "name": "base-multi-config",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo;MinSizeRel",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "msbuild-multi-config",
            "displayName": "MSBUILD Multi-config",
            "description": "Target Windows with the msvc compiler",
            "inherits": "base-multi-config",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "gcc-multi-config",
            "displayName": "GCC Multi-config",
            "description": "Target Unix-like OS with the gcc compiler",
            "inherits": "base-multi-config",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "clang-multi-config",
            "displayName": "Clang Multi-config",
            "description": "Target Unix-like OS with the clang compiler",
            "inherits": "base-multi-config",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "android-multi-config",
            "displayName": "Android NDK arm64-v8a",
            "description": "Target Android arm64-v8a using the NDK toolchain",
            "inherits": "base-multi-config",
            "cacheVariables": {
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "VCPKG_TARGET_TRIPLET": "arm64-android",
                "CMAKE_SYSTEM_NAME": "Android",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-24"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msbuild-build-debug",
            "configurePreset": "msbuild-multi-config",
            "configuration": "Debug"
        },
        {
            "name": "msbuild-build-release-dbg",
            "configurePreset": "msbuild-multi-config",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "gcc-build-debug",
            "configurePreset": "gcc-multi-config",
            "configuration": "Debug"
        },
        {
            "name": "gcc-build-release-dbg",
            "configurePreset": "gcc-multi-config",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "clang-build-debug",
            "configurePreset": "clang-multi-config",
            "configuration": "Debug"
        },
        {
            "name": "clang-build-release-dbg",
            "configurePreset": "clang-multi-config",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "android-build-debug",
            "configurePreset": "android-multi-config",
            "configuration": "Debug"
        },
        {
            "name": "android-build-release-dbg",
            "configurePreset": "android-multi-config",
            "configuration": "RelWithDebInfo"
        }
    ]
}